<Window x:Class="HistOSets.ViewerPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HISTOSETS — новый просмотрщик" Width="1200" Height="800"
        MinWidth="800" MinHeight="560" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closed="Window_Closed" Background="{StaticResource BrandBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10" Background="{StaticResource BrandSurfaceBrush}">
            <Button x:Name="DziButton" DockPanel.Dock="Right" Content="Открыть пирамиду DZI…" Click="Dzi_Click" IsEnabled="False"/>
            <TextBlock Text="Прототип: пробная разметка хранится только до закрытия окна." TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
        <wv:WebView2 x:Name="Browser" Grid.Row="1"/>
        <TextBlock x:Name="ViewerStatus" Grid.Row="2" Text="Загрузка просмотрщика…" TextWrapping="Wrap" Margin="0,10,0,0"
                   Background="{StaticResource BrandSurfaceBrush}"/>
    </Grid>
</Window>
