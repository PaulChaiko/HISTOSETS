<Window x:Class="HistOSets.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Данные атласа — HISTOSETS" Width="770" Height="700" MinWidth="660" MinHeight="620"
        Background="{StaticResource BrandBackgroundBrush}" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" FontSize="24" FontWeight="SemiBold" Foreground="#48396B"/>
        <TextBox x:Name="LocationText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" Margin="0,12,0,8"/>
        <TextBlock x:Name="StatisticsText" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,14" Background="{StaticResource BrandSurfaceBrush}" Padding="8"/>
        <Grid x:Name="NamePanel" Grid.Row="3" Margin="0,0,0,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="NameLabel" Grid.ColumnSpan="2" Margin="0,0,0,6"/>
            <TextBox x:Name="CatalogNameBox" Grid.Row="1" MaxLength="200"/>
            <Button x:Name="RenameButton" Grid.Row="1" Grid.Column="1" Click="Rename_Click" Margin="8,0,0,0"/>
        </Grid>
        <WrapPanel x:Name="Actions" Grid.Row="4">
            <Button x:Name="BackupButton" Click="Backup_Click" Margin="0,0,8,8"/>
            <Button x:Name="RestoreButton" Click="Restore_Click" Margin="0,0,8,8"/>
            <Button x:Name="OpenButton" Click="Open_Click" Margin="0,0,8,8"/>
            <Button x:Name="CreateXmlButton" Click="Create_Click" Margin="0,0,8,8"/>
            <Button x:Name="ImportButton" Click="Import_Click" Margin="0,0,8,8"/>
        </WrapPanel>
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0,8,0,12">
            <StackPanel>
                <TextBlock x:Name="HelpText" TextWrapping="Wrap" Background="{StaticResource BrandSurfaceBrush}" Padding="12"/>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="OperationPanel" Grid.Row="6" MaxHeight="150" Margin="0,0,0,12"
                      VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <TextBlock x:Name="OperationStatus" TextWrapping="Wrap" Padding="12" Background="{StaticResource BrandSurfaceBrush}"/>
        </ScrollViewer>
        <Button x:Name="CloseButton" Grid.Row="7" HorizontalAlignment="Right" IsCancel="True" MinWidth="100"/>
    </Grid>
</Window>
