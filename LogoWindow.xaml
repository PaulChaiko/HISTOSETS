<Window x:Class="HistOSets.LogoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogoWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="400" Height="200">
    <Grid>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

        <Image x:Name="LogoImage"
                   Source="LOGO/LOGO2.png"
                   Opacity="0.1"

                   RenderOptions.BitmapScalingMode="HighQuality"
                   Margin="0,0,0,20"/>


        <ProgressBar x:Name="LoadingProgressBar"
                        Height="20"
                        Width="300"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Foreground="#FF4285F4"
                        Background="#33000000"
                        BorderThickness="0">
            <ProgressBar.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#FF4285F4" Opacity="0.5"/>
            </ProgressBar.Effect>
        </ProgressBar>


        <TextBlock x:Name="StatusText"
                       Text="Загрузка..."
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Foreground="White"
                       FontSize="14"
                       Opacity="0"/>



    </StackPanel>

    </Grid>
</Window>
