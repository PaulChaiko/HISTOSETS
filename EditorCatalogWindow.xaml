<Window x:Class="HistOSets.EditorCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1010" Height="730" MinWidth="780" MinHeight="560"
        Background="{StaticResource BrandBackgroundBrush}" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Foreground="#48396B"/>
                <TextBlock x:Name="CatalogLabel" TextWrapping="Wrap" Margin="0,6,14,12"/>
            </StackPanel>
            <Button x:Name="LanguageButton" Grid.Column="1" Content="РУССКИЙ | ENGLISH" Click="Language_Click" VerticalAlignment="Top" Margin="0"/>
        </Grid>
        <Grid x:Name="FilterPanel" Grid.Row="1" Background="{StaticResource BrandSurfaceBrush}" Margin="0,0,0,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="8,8,10,8">
                <TextBlock x:Name="SearchLabel" Margin="0,0,0,4"/>
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,8,10,8">
                <TextBlock x:Name="StatusFilterLabel" Margin="0,0,0,4"/>
                <ComboBox x:Name="StatusSelector" SelectionChanged="Status_Changed" SelectedIndex="0" Padding="6">
                    <ComboBoxItem x:Name="AllStatusItem" Tag="all"/>
                    <ComboBoxItem x:Name="DraftStatusItem" Tag="draft"/>
                    <ComboBoxItem x:Name="ReadyStatusItem" Tag="ready"/>
                </ComboBox>
            </StackPanel>
            <Button x:Name="ResetButton" Grid.Column="2" Click="Reset_Click" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="8,0,8,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TypeLabel" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TypeSelector" DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" SelectionChanged="Type_Changed" Padding="5"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="TagLabel" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TagSelector" DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" SelectionChanged="Tag_Changed" Padding="5"/>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="78"><WrapPanel x:Name="SelectedTags"/></ScrollViewer>
            <TextBlock x:Name="FilterHint" TextWrapping="Wrap" FontSize="12" Foreground="#60576F"/>
        </StackPanel>
        <Grid Grid.Row="3">
            <ListBox x:Name="ObjectList" SelectionChanged="Object_Changed" MouseDoubleClick="Object_DoubleClick"
                     Background="{StaticResource BrandSurfaceBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/></Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="134"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="124" Height="96" Background="#F1EDF7" BorderBrush="#D7CDE9" BorderThickness="1" VerticalAlignment="Top">
                                <Grid>
                                    <TextBlock Text="{Binding ThumbnailHint}" Visibility="{Binding PlaceholderVisibility}" FontSize="12" Foreground="#60576F" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="6"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Loaded="Thumbnail_Loaded" Unloaded="Thumbnail_Unloaded" DataContextChanged="Thumbnail_DataContextChanged"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="#48396B" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Summary}" Margin="0,5,0,4" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"/>
                                <TextBlock Text="{Binding Metadata}" FontSize="12" Foreground="#60576F" TextWrapping="Wrap" MaxHeight="35" TextTrimming="CharacterEllipsis" ToolTip="{Binding Metadata}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{Binding StatusBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Top">
                                <TextBlock Text="{Binding StatusLabel}" FontSize="12"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyMessage" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Foreground="#60576F" IsHitTestVisible="False"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,10,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Foreground="#48396B" Margin="0,0,18,0"/>
            <TextBlock x:Name="OperationStatus" Grid.Column="1" TextWrapping="Wrap" Foreground="#60576F"/>
        </Grid>
        <Grid Grid.Row="5" x:Name="Actions">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel>
                <Button x:Name="NewButton" Click="New_Click" Background="{StaticResource SpecimenListBrush}"/>
                <Button x:Name="EditButton" Click="Edit_Click" IsEnabled="False"/>
                <Button x:Name="DeleteButton" Click="Delete_Click" IsEnabled="False"/>
                <Button x:Name="RefreshButton" Click="Refresh_Click"/>
            </WrapPanel>
            <Button x:Name="CloseButton" Grid.Column="1" IsCancel="True" Margin="0"/>
        </Grid>
    </Grid>
</Window>
