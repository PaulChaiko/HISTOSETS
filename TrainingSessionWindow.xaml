<Window x:Class="HistOSets.TrainingSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HistOSets.Controls"
        Title="HISTOSETS" Width="1120" Height="850" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F4F1F8"
        Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="LanguageHint" Foreground="#59545F" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <TextBlock x:Name="ProgressText" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="OperationStatus" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#59545F"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Click="Skip_Click"/>
                <Button x:Name="CheckAnswerButton" Click="Check_Click"/>
                <Button x:Name="NextButton" Click="Next_Click"/>
                <Button x:Name="FinishButton" Click="Finish_Click"/>
                <Button x:Name="CloseButton" Click="Close_Click" Visibility="Collapsed" Margin="0"/>
            </WrapPanel>
        </StackPanel>
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel x:Name="QuestionPanel">
                    <TextBlock x:Name="MethodText" Foreground="#70588F" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="QuestionHeading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <Border x:Name="DescriptionPanel" Background="White" BorderBrush="#DBD2E9" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14" Visibility="Collapsed">
                        <TextBlock x:Name="DescriptionText" FontSize="20" TextWrapping="Wrap" LineHeight="29"/>
                    </Border>
                    <controls:TrainingImageView x:Name="MainImageView" Height="355" Margin="0,0,0,14" Visibility="Collapsed"/>
                    <controls:TrainingDrawingView x:Name="TraceDrawingView" Height="420" Margin="0,0,0,14" Visibility="Collapsed"/>
                    <UniformGrid x:Name="ImageChoicesPanel" Columns="2" Margin="0,0,0,10" Visibility="Collapsed"/>
                    <StackPanel x:Name="NamedAnswerPanel">
                        <TextBlock x:Name="AnswerLabel" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <ComboBox x:Name="AnswerSelector" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" IsSynchronizedWithCurrentItem="False"
                                  DisplayMemberPath="Name" SelectionChanged="Answer_Changed" MinHeight="38" MaxDropDownHeight="260"
                                  HorizontalContentAlignment="Stretch" FontSize="16">
                            <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock x:Name="AnswerHint" TextWrapping="Wrap" Foreground="#59545F" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border x:Name="FeedbackPanel" Background="#EEE7F7" CornerRadius="8" Padding="15" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="FeedbackText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ResultsHeading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <Border Background="White" CornerRadius="8" Padding="16" Margin="0,10,0,10">
                        <TextBlock x:Name="ResultsSummary" FontSize="18" TextWrapping="Wrap" LineHeight="29"/>
                    </Border>
                    <TextBlock x:Name="ResultsHint" TextWrapping="Wrap" Foreground="#59545F" Margin="0,0,0,10"/>
                    <ListBox x:Name="ResultsList" SelectionChanged="Result_Changed" Height="210" Background="White"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ReviewHeading" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,8"/>
                    <TextBlock x:Name="ReviewAnswerText" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Border x:Name="ReviewDescriptionPanel" Background="White" BorderBrush="#DBD2E9" BorderThickness="1" Padding="16" CornerRadius="8" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="ReviewDescriptionText" FontSize="19" TextWrapping="Wrap"/>
                    </Border>
                    <controls:TrainingImageView x:Name="ReviewImageView" Height="340" Visibility="Collapsed"/>
                    <controls:TrainingDrawingView x:Name="ReviewDrawingView" Height="405" Visibility="Collapsed"/>
                    <UniformGrid x:Name="ReviewChoicesPanel" Columns="2" Visibility="Collapsed"/>
                    <TextBlock x:Name="ReviewStatus" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#59545F"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
