<Window x:Class="HistOSets.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HISTOSETS — update5.1" Width="850" Height="810" MinWidth="640" MinHeight="640"
        Background="{StaticResource BrandBackgroundBrush}" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="690">
                <Image Source="LOGO/LOGO2.png" Stretch="Uniform" Height="175" Margin="0,0,0,20"/>
                <Border Background="{StaticResource BrandSurfaceBrush}" BorderBrush="#B8A0E6" BorderThickness="2" Padding="18" CornerRadius="6">
                    <StackPanel>
                        <TextBlock x:Name="CatalogName" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#48396B"/>
                        <TextBlock x:Name="CatalogStatistics" FontSize="16" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CatalogModified" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CatalogPath" Foreground="#666666" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="StatusPanel" Background="{StaticResource BrandSurfaceBrush}" Padding="12" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
                </Border>
                <StackPanel x:Name="Actions" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="ChooseButton" Click="Choose_Click" MinHeight="42" FontSize="16"/>
                        <Button x:Name="FolderButton" Grid.Column="1" Click="Folder_Click" Margin="0"/>
                    </Grid>
                    <Button x:Name="CreateButton" Click="Create_Click" MinHeight="42" FontSize="16" Margin="0,8,0,0"/>
                    <Button x:Name="ViewButton" Click="View_Click" MinHeight="46" FontSize="18" Margin="0,14,0,0" Background="{StaticResource SpecimenListBrush}" IsEnabled="False"/>
                    <Button x:Name="SelfTestButton" MinHeight="40" Margin="0,8,0,0" IsEnabled="False"/>
                    <Button x:Name="EditButton" MinHeight="40" Margin="0,8,0,0" IsEnabled="False"/>
                    <Button x:Name="ManageButton" Click="Manage_Click" MinHeight="36" Margin="0,14,0,0"/>
                    <Button x:Name="DemoButton" Click="Demo_Click" MinHeight="36" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionLabel" VerticalAlignment="Center" Foreground="#48396B"/>
            <Button x:Name="LanguageButton" Grid.Column="1" Content="РУССКИЙ | ENGLISH" Click="Language_Click" Margin="0"/>
        </Grid>
    </Grid>
</Window>
