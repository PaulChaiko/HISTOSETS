<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>LOGO\Icon.ico</ApplicationIcon>
    <RootNamespace>HistOSets</RootNamespace>
    <Version>0.1.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);src/**;tests/**;Viewer/**;artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="src\HistOSets.Core\HistOSets.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Resource Include="LOGO\Icon.ico;LOGO\LOGO2.png" />
    <Content Include="ATLAS\ATLAS.xml;SPECIMENS\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Viewer\dist\**\*">
      <Link>Viewer\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="EnsureViewerAssets" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('Viewer/dist/index.html')" Text="Build viewer first: npm ci --prefix Viewer; npm run build --prefix Viewer" />
  </Target>
</Project>
