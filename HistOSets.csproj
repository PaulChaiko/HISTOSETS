<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>LOGO\Icon.ico</ApplicationIcon>
    <RootNamespace>HistOSets</RootNamespace>
    <Version>0.8.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);src/**;tests/**;tools/**;Viewer/**;artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="src\HistOSets.Core\HistOSets.Core.csproj" />
    <ProjectReference Include="src\HistOSets.Storage\HistOSets.Storage.csproj" />
    <Resource Include="LOGO\Icon.ico;LOGO\LOGO2.png;LOGO\GBL.png" />
    <Content Include="THIRD-PARTY-NOTICES.txt;licenses\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Demo.histosets" Condition="Exists('Demo.histosets')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
