<Window x:Class="HistOSets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HISTOSETS — update4" Height="840" Width="1360" MinWidth="1060" MinHeight="700"
        Background="{StaticResource BrandBackgroundBrush}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12" Background="{StaticResource BrandSurfaceBrush}">
            <TextBlock Text="HISTOSETS" FontSize="24" FontWeight="SemiBold" Foreground="#48396B" Margin="0,0,24,0"/>
            <Button Content="Обновить каталог" Click="Reload_Click"/>
            <Button Content="Данные атласа" Click="Data_Click"/>
            <Button x:Name="DictionaryButton" Content="Теги и группы…" Click="Dictionary_Click"/>
            <Button x:Name="PreviewButton" Content="Новый просмотрщик" Click="Preview_Click" IsEnabled="False"/>
            <Button x:Name="WarningsButton" Content="Замечания к данным" Click="Warnings_Click" Visibility="Collapsed"/>
            <TextBlock x:Name="CatalogCount" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#60576F"/>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10" Background="{StaticResource BrandSurfaceBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="185"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Поиск по названиям на всех языках" Margin="0,0,0,4"/>
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Можно ввести несколько слов. Регистр и е/ё не различаются."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Язык материала" Margin="0,0,0,4"/>
                <ComboBox x:Name="LanguageSelector" SelectedIndex="0" SelectionChanged="Options_Changed" Padding="6">
                    <ComboBoxItem Content="Русский" Tag="ru"/><ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="Порядок" Margin="0,0,0,4"/>
                <ComboBox x:Name="SortSelector" SelectedIndex="0" SelectionChanged="Options_Changed" Padding="6">
                    <ComboBoxItem Content="Исходный порядок"/><ComboBoxItem Content="По названию"/>
                </ComboBox>
            </StackPanel>
            <Button Grid.Column="3" Content="Сбросить поиск и фильтры" Click="ResetFilters_Click" VerticalAlignment="Bottom" Margin="0"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="260" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Background="{StaticResource BrandSurfaceBrush}">
                    <TextBlock Text="Материалы" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Expander x:Name="TagFilterExpander" Header="Фильтры по тегам" Margin="0,0,0,8">
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TagFilters" Margin="6"/></ScrollViewer>
                    </Expander>
                    <TextBlock x:Name="FilterSummary" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#60576F"/>
                </StackPanel>
                <ListBox x:Name="ListOfSpecimens" Grid.Row="1" SelectionChanged="Specimen_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8" Background="{StaticResource SpecimenListBrush}">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding LocaleLabel}" FontSize="11" Foreground="#48396B" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel Grid.Row="2" Background="{StaticResource BrandSurfaceBrush}" Margin="0,0,0,8">
                    <TextBlock x:Name="SelectedTagsText" TextWrapping="Wrap" MaxHeight="65" Margin="6"/>
                    <TextBlock x:Name="LanguageStatus" TextWrapping="Wrap" Foreground="#60576F" Margin="6,0,6,6"/>
                    <ComboBox x:Name="ImageSelector" SelectionChanged="Image_Changed" Visibility="Collapsed" DisplayMemberPath="Label" Margin="6"/>
                </StackPanel>
                <TextBox x:Name="AboutS" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal">
                    <Button x:Name="SInfo" Content="О препарате" Click="SInfo_Click" IsEnabled="False"/>
                    <Button x:Name="MaterialTagsButton" Content="Теги…" Click="MaterialTags_Click" IsEnabled="False" Margin="0"/>
                </StackPanel>
            </Grid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Padding="8">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="Desk" Width="800" Height="600" ClipToBounds="True">
                            <Image x:Name="Specimen" Width="800" Height="600" Stretch="Fill"/>
                        </Canvas>
                    </Viewbox>
                    <Image x:Name="WelcomeLogo" Source="LOGO/LOGO2.png" Stretch="Uniform" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                    <TextBlock x:Name="ImageMessage" Text="Выберите препарат" Foreground="#332D40" TextWrapping="Wrap"
                               Background="{StaticResource BrandSurfaceBrush}" Padding="14" TextAlignment="Center" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                <TextBlock Text="Элементы препарата" FontWeight="SemiBold" Margin="0,0,0,6" Background="{StaticResource BrandSurfaceBrush}"/>
                <Button x:Name="EInfo" Grid.Row="1" Content="Об элементе" Click="EInfo_Click" IsEnabled="False" Margin="0,0,0,8"/>
                <TextBox x:Name="AboutE" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ListBox x:Name="ListOfElements" Grid.Row="3" SelectionChanged="Element_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="{StaticResource ElementListBrush}">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="3"/></DataTemplate></ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#60576F"
                   Background="{StaticResource BrandSurfaceBrush}"/>
    </Grid>
</Window>
