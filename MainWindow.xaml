<Window x:Class="HistOSets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HISTOSETS" Height="860" Width="1400" MinWidth="1060" MinHeight="700"
        Background="{StaticResource BrandBackgroundBrush}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10" Background="{StaticResource BrandSurfaceBrush}">
            <TextBlock Text="HISTOSETS" FontSize="24" FontWeight="SemiBold" Foreground="#48396B" Margin="0,0,18,0"/>
            <Button x:Name="HomeButton" Click="Home_Click" Visibility="Collapsed"/>
            <Button x:Name="ReloadButton" Click="Reload_Click"/>
            <Button x:Name="DataButton" Click="Data_Click"/>
            <Button x:Name="DictionaryButton" Click="Dictionary_Click"/>
            <Button x:Name="AnalogGroupsButton" Click="AnalogGroups_Click"/>
            <Button x:Name="PreviewButton" Click="Preview_Click" IsEnabled="False" Visibility="Collapsed"/>
            <Button x:Name="WarningsButton" Click="Warnings_Click" Visibility="Collapsed"/>
            <TextBlock x:Name="CatalogCount" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#60576F"/>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10" Background="{StaticResource BrandSurfaceBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock x:Name="SearchLabel" Margin="0,0,0,4"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock x:Name="LanguageLabel" Margin="0,0,0,4"/>
                <ComboBox x:Name="LanguageSelector" SelectedIndex="0" SelectionChanged="Language_Changed" Padding="6">
                    <ComboBoxItem Content="Русский" Tag="ru"/><ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock x:Name="SortLabel" Margin="0,0,0,4"/>
                <ComboBox x:Name="SortSelector" SelectedIndex="0" SelectionChanged="Options_Changed" Padding="6">
                    <ComboBoxItem x:Name="OriginalOrderItem"/><ComboBoxItem x:Name="AlphabeticOrderItem"/>
                </ComboBox>
            </StackPanel>
            <Button x:Name="ResetFiltersButton" Grid.Column="3" Click="ResetFilters_Click" VerticalAlignment="Bottom" Margin="0"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270" MinWidth="215"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="6"/><ColumnDefinition Width="245" MinWidth="190"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Background="{StaticResource BrandSurfaceBrush}">
                    <TextBlock x:Name="MaterialsLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Expander x:Name="TagFilterExpander" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <TextBlock x:Name="TagTypeLabel"/>
                            <ComboBox x:Name="TagTypeSelector" DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" SelectionChanged="TagType_Changed" Margin="0,4,0,8"/>
                            <TextBlock x:Name="TagValueLabel"/>
                            <ComboBox x:Name="TagValueSelector" DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" SelectionChanged="TagValue_Changed" Margin="0,4,0,6"/>
                            <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TagFilters"/></ScrollViewer>
                        </StackPanel>
                    </Expander>
                    <ScrollViewer MaxHeight="85" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="SelectedFilterTags" Margin="0,0,0,4"/></ScrollViewer>
                    <TextBlock x:Name="FilterSummary" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#60576F"/>
                </StackPanel>
                <ListBox x:Name="ListOfSpecimens" Grid.Row="1" SelectionChanged="Specimen_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8" Background="{StaticResource SpecimenListBrush}">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/><TextBlock Text="{Binding LocaleLabel}" FontSize="11" Foreground="#48396B" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel Grid.Row="2" Background="{StaticResource BrandSurfaceBrush}" Margin="0,0,0,8">
                    <TextBlock x:Name="SelectedTagsText" TextWrapping="Wrap" MaxHeight="65" Margin="6" Visibility="Collapsed"/>
                    <TextBlock x:Name="LanguageStatus" TextWrapping="Wrap" Foreground="#60576F" Margin="6"/>
                    <ComboBox x:Name="ImageSelector" SelectionChanged="Image_Changed" Visibility="Collapsed" DisplayMemberPath="Label" Margin="6"/>
                </StackPanel>
                <TextBox x:Name="AboutS" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <WrapPanel Grid.Row="4"><Button x:Name="SInfo" Click="SInfo_Click" IsEnabled="False"/><Button x:Name="MaterialTagsButton" Click="Metadata_Click" IsEnabled="False" Margin="0"/></WrapPanel>
            </Grid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="2" Margin="4,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid ClipToBounds="True" Background="Black">
                    <Canvas x:Name="ImageViewport" ClipToBounds="True" Background="Transparent" SizeChanged="Viewport_SizeChanged"
                            MouseWheel="Viewport_MouseWheel" MouseLeftButtonDown="Viewport_MouseDown" MouseLeftButtonUp="Viewport_MouseUp" MouseMove="Viewport_MouseMove" LostMouseCapture="Viewport_LostCapture">
                        <Canvas x:Name="Desk" Width="800" Height="600" ClipToBounds="True" IsHitTestVisible="False">
                            <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="ImageScale"/><TranslateTransform x:Name="ImageOffset"/></TransformGroup></Canvas.RenderTransform>
                            <Image x:Name="Specimen" Width="800" Height="600" Stretch="Fill"/>
                        </Canvas>
                    </Canvas>
                    <Image x:Name="WelcomeLogo" Source="LOGO/LOGO2.png" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                    <TextBlock x:Name="ImageMessage" Foreground="#332D40" TextWrapping="Wrap" Background="{StaticResource BrandSurfaceBrush}" Padding="14" TextAlignment="Center" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False"/>
                    <Border x:Name="OverviewBorder" Width="156" Height="112" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" BorderThickness="1" BorderBrush="White" Background="#CC202020" Visibility="Collapsed">
                        <Canvas x:Name="OverviewCanvas" ClipToBounds="True" MouseLeftButtonDown="Overview_Click">
                            <Image x:Name="OverviewImage" IsHitTestVisible="False"/>
                            <Rectangle x:Name="OverviewRectangle" Stroke="White" StrokeThickness="1.5" Fill="#33FFFFFF" IsHitTestVisible="False"/>
                        </Canvas>
                    </Border>
                </Grid>
                <WrapPanel Grid.Row="1" Background="{StaticResource BrandSurfaceBrush}" Margin="0,8,0,0" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut_Click" Padding="10,4"/><Button x:Name="ZoomInButton" Content="+" Click="ZoomIn_Click" Padding="10,4"/>
                    <Button x:Name="ActualSizeButton" Content="100 %" Click="ActualSize_Click" Padding="8,4"/><Button x:Name="FitButton" Click="Fit_Click" Padding="8,4"/>
                    <TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="45"/>
                    <CheckBox x:Name="OutlineToggle" IsChecked="True" Checked="Outline_Changed" Unchecked="Outline_Changed" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="OpacityLabel" VerticalAlignment="Center"/><Slider x:Name="OutlineOpacity" Minimum="0" Maximum="1" Value="0.5" Width="75" ValueChanged="Outline_ValueChanged" VerticalAlignment="Center" Margin="4,0,10,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="HueLabel" VerticalAlignment="Center"/><Slider x:Name="OutlineHue" Minimum="0" Maximum="240" Value="180" Width="75" ValueChanged="Outline_ValueChanged" VerticalAlignment="Center" Margin="4,0"/></StackPanel>
                </WrapPanel>
            </Grid>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="ElementsLabel" FontWeight="SemiBold" Margin="0,0,0,6" Background="{StaticResource BrandSurfaceBrush}"/>
                <Button x:Name="EInfo" Grid.Row="1" Click="EInfo_Click" IsEnabled="False" Margin="0,0,0,8"/>
                <TextBox x:Name="AboutE" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ListBox x:Name="ListOfElements" Grid.Row="3" SelectionChanged="Element_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{StaticResource ElementListBrush}">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="3"/></DataTemplate></ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel x:Name="MeasurementsPanel" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="MeasurementsLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="MeasurementsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#60576F" Background="{StaticResource BrandSurfaceBrush}"/>
    </Grid>
</Window>
