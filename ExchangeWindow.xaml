<Window x:Class="HistOSets.ExchangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1120" Height="850" MinWidth="880" MinHeight="680"
        Background="{StaticResource BrandBackgroundBrush}" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,16">
                <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Foreground="#48396B"/>
                <TextBlock x:Name="CatalogLabel" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            <Button x:Name="LanguageButton" Grid.Column="1" Content="РУССКИЙ | ENGLISH" Click="Language_Click" VerticalAlignment="Top" Margin="0"/>
        </Grid>
        <TabControl x:Name="ExchangeTabs" Grid.Row="1" Background="{StaticResource BrandSurfaceBrush}" Padding="14">
            <TabItem x:Name="ExportTab">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ExportHint" TextWrapping="Wrap" Foreground="#60576F" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="SearchLabel" Margin="0,0,0,4"/>
                            <TextBox x:Name="SearchBox" TextChanged="Search_Changed"/>
                        </StackPanel>
                        <CheckBox x:Name="IncludeDeletedBox" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,9"
                                  Checked="IncludeDeleted_Changed" Unchecked="IncludeDeleted_Changed"/>
                    </Grid>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                        <Button x:Name="SelectAllButton" Click="SelectAll_Click"/>
                        <Button x:Name="ClearSelectionButton" Click="ClearSelection_Click"/>
                    </WrapPanel>
                    <Grid Grid.Row="3">
                        <ListBox x:Name="ExportList" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,8"/></Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
                                        <Grid Margin="8,0,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#48396B"/>
                                                <TextBlock Text="{Binding Identity}" Foreground="#60576F" FontSize="11" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyExportLabel" TextWrapping="Wrap" TextAlignment="Center" Foreground="#60576F" Padding="24"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SelectionCountLabel" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="ExportButton" Grid.Column="1" Click="Export_Click" Background="{StaticResource SpecimenListBrush}" Margin="0"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="ImportTab">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="80"/><RowDefinition Height="9"/><RowDefinition Height="180" MinHeight="80"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ImportHint" TextWrapping="Wrap" Foreground="#60576F" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <Button x:Name="LoadPackageButton" Grid.Column="1" Click="LoadPackage_Click" VerticalAlignment="Top" Margin="0"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#F1EDF7" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="PackageLabel" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#48396B"/>
                            <TextBlock x:Name="PackageDetailsLabel" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" Foreground="#60576F"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PreviewCountLabel" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Grid Grid.Row="3">
                        <DataGrid x:Name="PreviewList" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="White" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow"
                                  SelectionChanged="Preview_SelectionChanged" MinRowHeight="58" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="ObjectColumn" Width="*" MinWidth="180" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="9,6" ToolTip="{Binding Identity}">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="#48396B"/>
                                                <TextBlock Text="{Binding KindLabel}" FontSize="12" Foreground="#60576F" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ChangeColumn" Width="175" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" Margin="9,6" VerticalAlignment="Center" TextWrapping="Wrap"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="DecisionColumn" Width="230" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Resolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" Margin="8" Padding="7,5"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyPreviewLabel" TextWrapping="Wrap" TextAlignment="Center" Foreground="#60576F" Padding="24"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <GridSplitter x:Name="ComparisonSplitter" Grid.Row="4" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="#C8B8E1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
                    <Border Grid.Row="5" Background="#F1EDF7" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="DetailsNameLabel" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#48396B"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="LocalHeading" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock x:Name="LocalDetails" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="IncomingHeading" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock x:Name="IncomingDetails" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ItemWarningLabel" TextWrapping="Wrap" Foreground="#923500" Margin="0,7,0,0" FontSize="12"/>
                                <TextBlock x:Name="PreviewWarningLabel" TextWrapping="Wrap" Foreground="#923500" Margin="0,7,0,0" FontSize="12"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="6" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="DecisionHint" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="#60576F" Margin="0,0,18,0"/>
                        <Button x:Name="ApplyButton" Grid.Column="1" Click="Apply_Click" Background="{StaticResource SpecimenListBrush}" Margin="0"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100" Margin="0,0,16,0">
                <TextBlock x:Name="OperationStatus" TextWrapping="Wrap" Foreground="#60576F" VerticalAlignment="Center"/>
            </ScrollViewer>
            <Button x:Name="CloseButton" Grid.Column="1" IsCancel="True" VerticalAlignment="Bottom" Margin="0"/>
        </Grid>
    </Grid>
</Window>
