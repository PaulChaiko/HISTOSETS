<Window x:Class="HistOSets.AnalogGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="750" Height="590" MinWidth="620" MinHeight="480"
        Background="{StaticResource BrandBackgroundBrush}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" Foreground="#48396B" TextWrapping="Wrap"/>
        <TextBlock x:Name="Instructions" Grid.Row="1" TextWrapping="Wrap" Margin="0,10,0,12" Padding="10" Background="{StaticResource BrandSurfaceBrush}"/>
        <ListBox x:Name="GroupList" Grid.Row="2" DisplayMemberPath="Name" SelectionChanged="Group_Changed" Background="{StaticResource SpecimenListBrush}"/>
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="NewGroupButton" Click="NewGroup_Click" Margin="0,0,6,6"/>
            <Button x:Name="EditGroupButton" Click="EditGroup_Click" Margin="0,0,6,6"/>
            <Button x:Name="DeleteGroupButton" Click="DeleteGroup_Click" Margin="0,0,0,6"/>
        </WrapPanel>
        <TextBlock x:Name="OperationStatus" Grid.Row="4" TextWrapping="Wrap" Margin="0,4,0,12" Padding="8" Background="{StaticResource BrandSurfaceBrush}"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveAssignmentButton" Click="SaveAssignment_Click"/>
            <Button x:Name="CloseButton" IsCancel="True" MinWidth="100" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
