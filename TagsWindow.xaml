<Window x:Class="HistOSets.TagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Теги и группы — HISTOSETS" Width="900" Height="650" MinWidth="760" MinHeight="570"
        Background="{StaticResource BrandBackgroundBrush}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Text="Теги и группы" FontSize="23" FontWeight="SemiBold" Foreground="#48396B" TextWrapping="Wrap"/>
        <TextBlock x:Name="Instructions" Grid.Row="1" TextWrapping="Wrap" Margin="0,10,0,12" Padding="10" Background="{StaticResource BrandSurfaceBrush}"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Группы" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ListBox x:Name="GroupList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="Group_Changed" Background="{StaticResource SpecimenListBrush}"/>
                <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button Content="Создать…" Click="NewGroup_Click" Margin="0,0,6,6"/>
                    <Button Content="Изменить…" Click="EditGroup_Click" Margin="0,0,6,6"/>
                    <Button Content="Удалить" Click="DeleteGroup_Click" Margin="0,0,0,6"/>
                </WrapPanel>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Теги" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ListBox x:Name="TagList" Grid.Row="1" Background="{StaticResource ElementListBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="3">
                        <CheckBox IsChecked="{Binding Assigned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding AssignmentVisibility}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                    </DockPanel></DataTemplate></ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                </ListBox>
                <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button Content="Создать тег…" Click="NewTag_Click" Margin="0,0,6,6"/>
                    <Button Content="Изменить…" Click="EditTag_Click" Margin="0,0,6,6"/>
                    <Button Content="Удалить" Click="DeleteTag_Click" Margin="0,0,0,6"/>
                </WrapPanel>
            </Grid>
        </Grid>
        <TextBlock x:Name="OperationStatus" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,12" Padding="8" Background="{StaticResource BrandSurfaceBrush}"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveAssignments" Content="Сохранить теги материала" Click="SaveAssignments_Click"/>
            <Button Content="Закрыть" IsCancel="True" MinWidth="100" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
